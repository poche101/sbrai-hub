APP_NAME="Sbrai Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# MUST be the real public URL in production (e.g. https://sbraisolutions.com).
# Payment return URLs (Paystack/Espees) are built from this.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Paystack ────────────────────────────────────────────────────────
# Webhook URL to set in the Paystack dashboard (Settings > API Keys & Webhooks):
#   https://sbraisolutions.com/api/v1/webhooks/paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ─── Espees ──────────────────────────────────────────────────────────
ESPEES_ENV=live
ESPEES_BASE_URL=https://api.espees.org/v2
ESPEES_PAYMENT_PORTAL_URL=https://payment.espees.org/pay
# Merchant token (sent as the x-api-key header)
ESPEES_API_KEY=
ESPEES_MERCHANT_ADDRESS=4ccfc060037382fb506f17b533fe6d0e50c0165cf2a0252f
ESPEES_SECRET_KEY=1800
ESPEES_WEBHOOK_SECRET=

# ─── Social login ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── KYC (Mono) ──────────────────────────────────────────────────────
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=

# ─── Translation ─────────────────────────────────────────────────────
GOOGLE_TRANSLATE_KEY=

# ─── Calling (Agora) ─────────────────────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── SMS (Termii) ────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_BASE_URL=https://api.termii.com
